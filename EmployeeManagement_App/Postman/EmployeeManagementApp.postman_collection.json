          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/LeaveRequests" }
        },
        {
          "name": "Approve Leave Request",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('Leave request is approved', () => pm.expect(body.data.status).to.eql(1));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"employeeId\": {{employeeId}},\n  \"startDate\": \"2026-10-01\",\n  \"endDate\": \"2026-10-03\",\n  \"reason\": \"Approved Postman integration test\",\n  \"status\": 1\n}" },
            "url": "{{baseUrl}}/api/LeaveRequests/{{leaveRequestId}}"
          }
        }
      ]
    },
    {

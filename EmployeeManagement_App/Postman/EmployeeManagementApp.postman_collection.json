        {
          "name": "Expect 400 - Invalid Leave Date Range",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 400', () => pm.response.to.have.status(400));",
            "pm.test('Date error is clear', () => pm.expect(pm.response.json().message).to.include('End date'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"employeeId\": {{employeeId}},\n  \"startDate\": \"2026-10-10\",\n  \"endDate\": \"2026-10-01\",\n  \"reason\": \"Invalid range test\"\n}" },
            "url": "{{baseUrl}}/api/LeaveRequests"
          }
        },
        {
          "name": "Create Leave Request",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 201', () => pm.response.to.have.status(201));",

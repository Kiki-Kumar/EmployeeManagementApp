            "pm.collectionVariables.set('leaveRequestId', body.data.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"employeeId\": {{employeeId}},\n  \"startDate\": \"2026-10-01\",\n  \"endDate\": \"2026-10-03\",\n  \"reason\": \"Postman integration test\"\n}" },
            "url": "{{baseUrl}}/api/LeaveRequests"
          }
        },
        {
          "name": "Get Leave Request By ID",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('Correct leave request is returned', () => pm.expect(body.data.id).to.eql(Number(pm.collectionVariables.get('leaveRequestId'))));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/LeaveRequests/{{leaveRequestId}}" }
        },
        {
          "name": "Get All Leave Requests",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
